{
  "manifest_version": 3,
  "name": "玉鳳台院內報告小幫手",
  "version": "1.4.0",
  "description": "Fetch and cache lab and imaging reports by chart number",
  "permissions": ["storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "玉鳳台院內報告小幫手"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["report-viewer.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
